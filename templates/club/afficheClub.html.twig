{% extends 'dash.html.twig' %}

{% block title %}Liste des Clubs{% endblock %}

{% block body %}
<h1 class="text-center">Liste des Clubs</h1>

<!-- Bouton pour ajouter un nouveau club -->
<a href="{{ path('app_ajoutclub') }}" class="btn btn-primary mb-3">Créer un Nouveau Club</a>
<a href="{{ path('app_ajout_type_club') }}" class="btn btn-primary mb-3">Créer un Nouveau Type Club</a>

<div class="card mt-4">
    <div class="card-header">
        <div class="card-title">Liste des Clubs</div>
    </div>
    <div class="card-body">
        <!-- Tableau avec en-tête coloré -->
        <table class="table table-head-bg-success">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Date de Création</th>
                    <th>Image</th> <!-- Nouvelle colonne pour l'image -->
                    <th>Places Disponibles</th> <!-- Nouvelle colonne pour les places -->
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for club in clubs %}
                    <tr>
                        <td>{{ club.id }}</td>
                        <td>{{ club.name }}</td>
                        <td>{{ club.description }}</td>
                        <td>{{ club.type.categorieClub }}</td> <!-- Afficher le type du club -->
                        <td>{{ club.dateCreation|date('Y-m-d') }}</td>
                        
                        <!-- Affichage de l'image si elle existe -->
                        <td>
                            {% if club.image %}
                                <img src="{{ asset('uploads/images/' ~ club.image) }}" 
                                     alt="Image de {{ club.name }}" 
                                     class="img-fluid" style="max-width: 50px;">
                            {% else %}
                                Pas d'image
                            {% endif %}
                        </td>
                        
                        <!-- Affichage des places disponibles -->
                        <td>{{ club.placesDisponibles }}</td>

                        <td>
                            <div class="d-flex gap-2">
                                <!-- Bouton Modifier -->
                                <a href="{{ path('app_editClub_form', { id: club.id }) }}" 
                                   class="btn btn-warning btn-sm">
                                    Modifier
                                </a>

                                <!-- Formulaire pour supprimer un club -->
                                <form action="{{ path('app_deleteClub') }}" method="POST" style="display: inline;">
                                    <input type="hidden" name="id" value="{{ club.id }}">
                                    <button type="submit" class="btn btn-danger btn-sm" 
                                            onclick="return confirm('Voulez-vous vraiment supprimer ce club ?');">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center">Aucun club trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <!-- Affichage des clubs avec leurs places disponibles (si nécessaire en dehors du tableau) -->
        {% for club in clubs %}
            <div class="mt-3">
                <h3>{{ club.name }}</h3>
                <p>Places disponibles : {{ club.placesDisponibles }}</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block footer %}
{% endblock %}
