{% extends 'dash.html.twig' %}

{% block title %}
    Ajouter un Événement
{% endblock %}

{% block head %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        h1 {
            font-weight: bold;
            text-align: center;
            color: #007bff;
            margin-top: 30px;
        }

        .form-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #f9f9f9;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control {
            border-radius: 5px;
            border-color: #ccc;
            padding: 10px;
        }

        .btn-submit {
            background-color: #28a745;
            border-color: #28a745;
            color: white;
            text-transform: uppercase;
            font-weight: bold;
            padding: 10px 20px;
            margin-right: 10px;
            transition: background-color 0.3s ease;
        }

        .btn-submit:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

        .btn-cancel {
            background-color: #dc3545;
            border-color: #dc3545;
            color: white;
            text-transform: uppercase;
            font-weight: bold;
            padding: 10px 20px;
            transition: background-color 0.3s ease;
        }

        .btn-cancel:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }

        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
            color: white;
        }

        .card-header {
            background-color: #007bff;
            color: white;
            text-align: center;
            font-weight: bold;
        }

        .card-body {
            padding: 20px;
        }

        .card-title {
            font-size: 20px;
        }

        .form-text {
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <div class="card-title">Ajouter un Événement</div>
        </div>
        <div class="card-body">
            {{ form_start(f, {'attr': {'enctype': 'multipart/form-data'}}) }}
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(f.titreE, 'Titre de l\'événement') }}
                        {{ form_widget(f.titreE, {'attr': {'class': 'form-control' ~ (not f.titreE.vars.valid ? ' is-invalid' : '')}}) }}
                        <div class="invalid-feedback">
                            {{ form_errors(f.titreE) }}
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(f.dateE, 'Date de l\'événement') }}
                        {{ form_widget(f.dateE, {'attr': {'class': 'form-control' ~ (not f.dateE.vars.valid ? ' is-invalid' : '')}}) }}
                        <div class="invalid-feedback">
                            {{ form_errors(f.dateE) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                {{ form_label(f.descriptionE, 'Description') }}
                {{ form_widget(f.descriptionE, {'attr': {'class': 'form-control' ~ (not f.descriptionE.vars.valid ? ' is-invalid' : '')}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(f.descriptionE) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(f.typeE, 'Type personnalisé') }}
                {{ form_widget(f.typeE, {'attr': {'class': 'form-control' ~ (not f.typeE.vars.valid ? ' is-invalid' : '')}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(f.typeE) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(f.typeEvenement, 'Type(s) d\'événement') }}
                {{ form_widget(f.typeEvenement, {'attr': {'class': 'form-control' ~ (not f.typeEvenement.vars.valid ? ' is-invalid' : '')}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(f.typeEvenement) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(f.image, 'Image de l\'événement') }}
                {{ form_widget(f.image, {'attr': {'class': 'form-control' ~ (not f.image.vars.valid ? ' is-invalid' : '')}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(f.image) }}
                </div>
                <small class="form-text text-muted">Formats acceptés : JPG, PNG</small>
            </div>

            <div class="card-action text-center">
                {{ form_widget(f.save, {'attr': {'class': 'btn btn-success'}}) }}
                {{ form_widget(f.reset, {'attr': {'class': 'btn btn-danger'}}) }}
            </div>
            {{ form_end(f) }}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
