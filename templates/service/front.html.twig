{% extends 'baseformation.html.twig' %}

{% block body %}
    <div class="site-section bg-light pb-0">
        <div class="container">
            <!-- Titre principal -->
            <div class="text-center mb-5">
                <h2 class="section-title">Nos formations</h2>
            </div>

            <!-- Grille des formations -->
            <div class="row">
                {% for formation in formations %}
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100">
                            <!-- Affichage de l'image de la formation -->
                            {% if formation.image %}
                                <img src="{{ asset('uploads/' ~ formation.image) }}" 
                                     alt="Image de {{ formation.titre }}" 
                                     class="card-img-top" 
                                     style="width: 100%; height: 300px; object-fit: cover; border-radius: 8px;">
                            {% else %}
                                <div class="card-img-top text-center bg-light text-muted" 
                                     style="width: 100%; height: 300px; display: flex; align-items: center; justify-content: center; border-radius: 8px;">
                                    <p>Pas d'image disponible</p>
                                </div>
                            {% endif %}

                            <div class="card-body">
                                <!-- Affichage du titre -->
                                <h5 class="card-title text-center">{{ formation.titre }}</h5>

                                <!-- Affichage des détails de la formation -->
                                <p class="card-text"><strong>Description:</strong> {{ formation.description }}</p>
                                <p class="card-text"><strong>Type de formation:</strong> {{ formation.typeformation.libelle }}</p>

                              
                            
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <p class="text-center text-muted">Aucune formation disponible.</p>
                    </div>
                {% endfor %}
            </div>

   

   
{% endblock %}
